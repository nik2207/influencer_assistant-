# --- Core ---
SECRET_KEY=MbPkxDhH0uKb_Sxq60Jf64EhgTE7DFBtLhLNd3hy5gRyepmnFKq_53IXevl-LCKk
8zruPLIcAzXLC4vSQMzVqZuBcx5oShV8PTzpd15fe1s
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
DATABASE_URL=sqlite:///./data/app.db
# For Postgres: postgresql+psycopg2://assistant:assistant@localhost:5432/assistant

# --- LLM ---
# mock = rule-based demo brain, works with no model at all
# openai_compat = any OpenAI-compatible server (Ollama, Groq, Gemini, OpenRouter)
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1
# Groq:       https://api.groq.com/openai/v1
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter: https://openrouter.ai/api/v1

# --- Speech ---
WHISPER_MODEL=small

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Payments (optional, test mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
UPI_VPA=

# --- Infra ---
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:8000

# --- Gmail (see README: Gmail setup) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback

# --- Google Calendar + follow-ups ---
# Calendar uses the same Google client as Gmail. Enable the Google Calendar API and add the
# scope https://www.googleapis.com/auth/calendar.events in Google Cloud, then click "Connect Google Calendar".
REPLY_AFTER_DAYS=2
FOLLOWUP_AFTER_DAYS=3
CALENDAR_PULL_DAYS=30

# Runs reminders, Gmail sync, calendar sync and follow-up checks inside the API process (no Redis needed).
BACKGROUND_JOBS=true
BACKGROUND_INTERVAL_MINUTES=10
